[% BLOCK bottom_links %]
    [% FOREACH page IN ['Versions', 'Credits', 'Download', 'Rubrics', 'Technical', 'Help'] %]
        &emsp;<A HREF="[% path_for('_help', {page => page.lower}) %]" TARGET="_BLANK">[% page %]</A>
    [% END %]
[% END %]

[% MACRO html_input(name, value, mode, par, func, help) BLOCK %]
    [% pos = CALL substr(name, 1) %]

    [% IF mode == 'label' %]
my $ilabel = $parvalue;
if ($parpar) { $ilabel = wrap($ilabel, $parpar, "<br/>\n"); }
$output .= "$ilabel";
        [% IF par; par; ELSE; value; END %]
        <INPUT TYPE='HIDDEN' NAME='[% name %]' VALUE='[% value %]'>
    [% ELSIF mode == 'entry' %]
        $width = $parpar;
        if (!$width || $width == 0) { $width = 3; }
        <INPUT TYPE='TEXT' NAME='[% name %]' ID='[% name %]' [% IF func %]onchange="[% func %];"[% END %] SIZE=[% width %] VALUE='[% value %]'>
    [% ELSIF mode == 'text' %]
my @size = split('x', $parpar);
if (@size < 2) { @size = (3, 12); }
my $pv = $parvalue;
$pv =~ s/  /\n/g;
my $loadfile = strictparam('loadfile');

if ($loadfile) {
$loadfile =~ s/\.gen//;

if (@cm = do_read("$datafolder/gen/$loadfile.gen")) {
$pv = join('', @cm);
}
}
my $savefile = strictparam('savefile');

if ($savefile) {
$savefile =~ s/\.gen//;
do_write("$datafolder/gen/$savefile.gen", $pv);
}
        <TEXTAREA NAME='[% name %]' ID='[% name %]' COLS='$size[1]' ROWS='$size[0]'>$pv</TEXTAREA><br/>
        <A HREF='#' onclick='loadrut();'>[% set_font(dialogfont, 'Load') %]</A>
    [% ELSIF mode == 'checkbutton' %]
my $checked = ($parvalue) ? 'CHECKED' : '';
        <INPUT TYPE='CHECKBOX' NAME='[% name %]' ID='[% name %]' $checked [% IF func %]onclick="[% func %];"[% END %]>
    [% ELSIF mode == 'radio' %]
if ($parmode =~ /vert/i) { $output .= "<TABLE>"; }
    $rpar = $parpar;
    @rpar = split(',', $rpar);

    for (my $j = 1; $j <= @rpar; $j++) {
    my $checked = ($parvalue == $j) ? 'CHECKED' : '';
    if ($parmode =~ /vert/i) { $output .= "<TR><TD>"; }
            my $jsfunc = '';
            if ($parfunc) { $jsfunc = "onclick=\"$parfunc;\""; }
            $output .= "<INPUT TYPE=RADIO NAME=\'$parname\' ID=\'$parname\' VALUE=$j $checked $jsfunc>";
            $output .= "<FONT SIZE=-1> $rpar[$j-1] </FONT>\n";
            if ($parmode =~ /vert/i) { $output .= "</TD></TR>"; }
    }
    if ($parmode =~ /vert/i) { $output .= "</TABLE>"; }
        [% ELSIF mode == 'updown' %]
if (!$parvalue && $parvalue != 0) { $parvalue = 5; }
            <IMG SRC=\"$htmlurl/down.gif\" ALT=down ALIGN=TOP onclick=\"$parfunc($parpos,-1)\">\n";
            <INPUT TYPE=TEXT NAME=\'$parname\' ID=\'$parname\' SIZE=$parpar "
. "VALUE=$parvalue onchange=\"$parfunc($parpos,0);\">\n";
            <IMG SRC=\"$htmlurl/up.gif\" ALT=up ALIGN=TOP onclick=\"$parfunc($parpos,1);\">\n";
    [% ELSIF mode == 'scale' %]
        <INPUT TYPE=TEXT SIZE=6 NAME=\'$parname\' ID=\'$parname\' VALUE=$parvalue>
    [% ELSIF mode == 'filesel' %]
if ($parpar =~ /stack/i) {
$output .= "<INPUT TYPE=RADIO NAME='mousesel' VALUE='stack'" . " onclick=\'mouserut(\"stack$parpos\");\'>\n";
}
$output .= "<INPUT TYPE=TEXT SIZE=16 NAME=\'$parname\' ID=\'$parname\'" . " VALUE=\'$parvalue\'>\n";

if ($parpar !~ /stackonly/i) {
$output .= "<INPUT TYPE=BUTTON VALUE=' ' onclick='filesel(\"$parname\", \"$parpar\");'>\n";
}
        [% ELSIF mode == 'color' %]
my $size = 3;
if ($parpar) { $size = $parpar; }
            <INPUT TYPE=RADIO NAME='mousesel' VALUE='color'" . " onclick=\'mouserut(\"color$parpos\");\'>
            <INPUT TYPE=TEXT SIZE=8 NAME=\'$parname\' ID=\'$parname\'" . " VALUE=\'$parvalue\'>
            <INPUT TYPE=BUTTON VALUE=' ' onclick='colorsel(\"$parname\",$size);'>
        [% ELSIF mode == 'font' %]
my $size = 16;
if ($parpar) { $size = $parpar }
        <INPUT TYPE=TEXT SIZE=$size NAME=\'$parname\' ID=\'$parname\'" . " VALUE=\'$parvalue\'>
        <INPUT TYPE=BUTTON VALUE=' ' onclick='fontsel("[% name %]");'>
    [% ELSIF mode == 'options' %]
my @optarray;
if ($a =~ /\@/ || ref($a) =~ /ARRAY/i) {
@optarray = eval($a);
} elsif ($a =~ /^\s*\{(.+)\}\s*$/) {
@optarray = split(',', $1);
} else {
@optarray = getdialog($a);
}
my $onclick =
($parmode =~ /select/i) ? "onchange=\'buttonclick(\"$command\");\'"
: ($parfunc) ? qq(onchange="$parfunc;")
: '';
my $osize = @optarray;
chomp($optarray[-1]);
        <SELECT ID=[% parname %] NAME=[% parname %] SIZE=1 $onclick>
            [% FOREACH item IN optarray %]
                my ($display, $value) = split(/\//);
                $value ||= $display;
                <OPTION [% IF value == parvalue %]SELECTED[% END %] VALUE="[% value %]">[% display %]
            [% END %]
        </SELECT>
    [% END %]
[% END %]

[% MACRO set_font(font, text) BLOCK %]
#*** setfont($font, $text)
# input font description is "[size][ italic][ bold] color" format, and the text
# returns <FONT ...>$text</FONT> string
sub setfont($istr, $text) {
return $text unless $istr;

my $size = ($istr =~ /^\.*?([0-9\-\+]+)/i) ? $1 : 0;
my $color = ($istr =~ /([a-z]+)\s*$/i) ? $1 : '';
if ($istr =~ /(\#[0-9a-f]+)\s*$/i || $istr =~ /([a-z]+)\s*$/i) { $color = $1; }
$color = '' if $color eq 'italic';                                    # italic is not a color
my $font = "<FONT ";
if ($size) { $font .= "SIZE='$size' "; }
if ($color && $color !~ /black/i) { $font .= "COLOR=\"$color\""; }    # black not explictly for dark mode
$font .= ">";
if (!$text) { return $font; }
my $bold = '';
my $bolde = '';
my $italic = '';
my $italice = '';
if ($istr =~ /bold/) { $bold = "<B>"; $bolde = "</B>"; }
if ($istr =~ /italic/) { $italic = "<I>"; $italice = "</I>"; }
return "$font$bold$italic$text$italice$bolde</FONT>";
}
[% END %]
